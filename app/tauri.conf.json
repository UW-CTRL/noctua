{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctua",
  "identifier": "app.noctua.desktop",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "python3 prepare-server.py"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/UW-CTRL/noctua/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Research-paper explorer with citation graphs and LaTeX notes",
    "longDescription": "Noctua explores Semantic Scholar citation graphs, a native PDF library with annotations, and LaTeX/handwritten notes, with a built-in Codex or Claude Code research assistant.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "binaries/": "binaries/",
      "../target/tectonic/": "tectonic/",
      "../target/texlive/": "texlive/"
    }
  }
}
